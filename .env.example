# ==============================================================================
# AI RED DRAGON - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy these variables into your local `.env` file to configure your credentials.
# Note: If any API key is omitted, the application automatically uses the
# built-in Zero-Cost Algorithmic Intelligence Engine ($0 spend).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
# Powers: Educational blueprints, report generation, and Gemini Search Grounding
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. OPENAI CHATGPT (GPT-4o)
# ------------------------------------------------------------------------------
# Obtain from: https://platform.openai.com/api-keys
# Powers: ChatGPT persona in the Multi-AI Assistant
OPENAI_API_KEY="your_openai_api_key_here"

# ------------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE (Claude 3.5 Sonnet)
# ------------------------------------------------------------------------------
# Obtain from: https://console.anthropic.com/settings/keys
# Powers: Claude persona in the Multi-AI Assistant
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# ------------------------------------------------------------------------------
# 4. xAI GROK (Grok-2 / Grok-3)
# ------------------------------------------------------------------------------
# Obtain from: https://console.x.ai
# Powers: Grok persona in the Multi-AI Assistant
XAI_API_KEY="your_xai_api_key_here"

# ------------------------------------------------------------------------------
# 5. JITSI MEET VIDEO CONFERENCING
# ------------------------------------------------------------------------------
# Powers: Faculty consultation rooms and video meetings
# Default public server: meet.jit.si (Free, no account required)
# Or configure your own self-hosted domain or 8x8 JaaS domain
JITSI_DOMAIN="meet.jit.si"
JITSI_ROOM_PREFIX="AI_Red_Dragon_Consult_"

# ------------------------------------------------------------------------------
# 6. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# Injected at runtime by AI Studio or set to your deployment URL
APP_URL="http://localhost:3000"

