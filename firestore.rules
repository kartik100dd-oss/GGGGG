rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth and validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Rules for user profiles, reports, and chats
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);

      match /reports/{reportId} {
        allow get, write: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);
      }

      match /chats/{chatId} {
        allow get, write: if isOwner(userId) && isValidId(chatId);
        allow list: if isOwner(userId);
      }

      match /news_bookmarks/{bookmarkId} {
        allow get, write: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);
      }

      match /wellness_checkins/{checkinId} {
        allow get, write: if isOwner(userId) && isValidId(checkinId);
        allow list: if isOwner(userId);
      }
    }

    // Rules for shared, view-only reports
    match /shared_reports/{sharedId} {
      allow get: if true;
      allow create, update: if isAuthenticated() && isValidId(sharedId);
      allow delete: if false;
    }
  }
}
